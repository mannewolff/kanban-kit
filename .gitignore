# claude-workflow-kit (Issue #208): workflow.config.json gehoert ins Repo,
# alles andere unter .claude/ ist lokaler Zustand.
.claude/*
!.claude/workflow.config.json
.claude/workflow.config.local.json
.claude/board-meta-cache.json
.idea/
# Maven / Java
target/
*.class

# Umgebung (Secrets)
.env

# Lokales Nachschlage-Log des Sonar-Sync-Skripts — nicht Quelle der Wahrheit
# (Duplikat-Prüfung läuft live gegen GitHub, siehe scripts/sync-sonar-issues-to-github.mjs).
scripts/.sonar-issue-map.json

# Node (Frontend hat zusätzlich eine eigene .gitignore)
/node_modules/
frontend/node_modules/
frontend/dist/

# VitePress-Doku-Build
docs-site/node_modules/
docs-site/package-lock.json
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/

# OS / Editor
.DS_Store

install.mjs

# Lokale Issue-Notlösung des Board-Adapters (Fallback bei Tracker-Ausfall) — Arbeitsdateien, kein Commit-Ziel
issues/

# JVM-Crash-Logs abstuerzender PIT-Minions (SIGSEGV auf OpenJDK/aarch64) — Build-Muell, kein Commit-Ziel
hs_err_pid*.log

# Ad-hoc erhobene Code-Metriken (Praesentationsmaterial) — Momentaufnahme, veraltet sofort
kanban-kit-metriken.md

.agents/
.codex/


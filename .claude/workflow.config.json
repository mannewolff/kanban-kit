{
  "codeHost": "github",
  "issueTracker": "toolbox",
  "buildChecks": [
    "mvn verify",
    "npm --prefix frontend run build",
    "npm --prefix frontend run lint",
    "npm --prefix frontend run test:coverage"
  ],
  "mutationCommand": "mvn -Ppit -Dskip.frontend=true test",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "reviewCommand": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\"",
  "formatFixCommand": "mvn spotless:apply",
  "github": {
    "projectNumber": 13
  },
  "reviewStufen": {
    "fachlich": {
      "reviewer": 2,
      "rollen": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 2,
      "rollen": [
        "architektur-bestand",
        "schnitt-abhaengigkeiten"
      ]
    },
    "issue": {
      "reviewer": 1,
      "rollen": [
        "pruefbarkeit"
      ]
    }
  },
  "toolbox": {
    "host": "https://kanban.mwolff.org",
    "tokenFile": ".claude/toolbox.cli/tbx.token",
    "ideaStored": false
  },
  "issueReview": {
    "rounds": 1,
    "requiredBeforeReady": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5.1"
      },
      {
        "name": "gpt-sol",
        "kind": "command",
        "model": "gpt-5.6-sol,
        "command": "codex exec --model gpt-5.6-sol -c model_reasoning_effort=\"high\""
      },
      {
        "name": "gpt-astra",
        "kind": "command",
        "model": "gpt-6-astra",
        "command": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\""
      }
    ],
    "pairs": {
      "opus": [
        "fable",
        "gpt-astra"
      ],
      "sonnet": [
        "fable",
        "gpt-sol"
      ],
      "fable": [
        "opus",
        "gpt-astra"
      ]
    },
    "statusLabels": true
  }
}

    {
      "cmd": "node scripts/mutationspruefung.mjs aenderung backend",
      "areas": [
        "backend"
      ],
      "stage": "push",
      "concurrent": true
    },
    {
      "cmd": "node scripts/mutationspruefung.mjs vollauf backend",
      "stage": "push",
      "concurrent": true

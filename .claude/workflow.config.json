{
  "codeHost": "github",
  "issueTracker": "toolbox",
  "buildChecks": [
    {
      "cmd": "mvn verify",
      "areas": [
        "backend",
        "doku"
      ]
    },
    {
      "cmd": "npm --prefix frontend run build",
      "areas": [
        "frontend"
      ]
    },
    {
      "cmd": "npm --prefix frontend run lint",
      "areas": [
        "frontend"
      ]
    },
    {
      "cmd": "npm --prefix frontend run test:coverage",
      "areas": [
        "frontend"
      ]
    },
    {
      "cmd": "node --test cli/tbx.test.mjs",
      "areas": [
        "cli"
      ]
    }
  ],
  "mutationCommand": "mvn -Ppit -Dskip.frontend=true test",
  "mainBranch": "main",
  "productionBranch": "production",
  "reviewScope": "diff",
  "triggers": {
    "go": "GO",
    "push": "push main",
    "merge": "merge production"
  },
  "local": {
    "issuesDir": "issues"
  },
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "in_progress": "In progress",
    "in_review": "In review",
    "done": "Done"
  },
  "checkAreas": {
    "backend": [
      "src/**",
      "pom.xml",
      "config/**"
    ],
    "frontend": [
      "frontend/**",
      "CLAUDE-design.md"
    ],
    "doku": [
      "docs/**",
      "docs-site/**"
    ],
    "cli": [
      "cli/**"
    ]
  },
  "reviewCommand": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\"",
  "formatFixCommand": "mvn spotless:apply",
  "github": {
    "projectNumber": 13
  },
  "reviewStufen": {
    "fachlich": {
      "reviewer": 2,
      "rollen": [
        "form-beobachtbarkeit",
        "abgrenzung"
      ]
    },
    "plan": {
      "reviewer": 1,
      "rollen": [
        "architektur-bestand"
      ]
    },
    "issue": {
      "reviewer": 1,
      "rollen": [
        "pruefbarkeit"
      ]
    }
  },
  "night": {
    "kette": {
      "label": "kit:night",
      "planMin": 30,
      "paketeMin": 25,
      "reviewMin": 30,
      "abdeckungMin": 10,
      "kostenUsd": 50,
      "korrekturrunden": 2
    },
    "modelle": [
      "claude-opus-5",
      "claude-sonnet-5",
      "claude-fable-5"
    ],
    "stufen": {
      "schwer": {
        "modell": "claude-opus-5"
      },
      "mittel": {
        "modell": "claude-opus-5",
        "effort": "medium"
      },
      "leicht": {
        "modell": "claude-opus-5",
        "effort": "low"
      }
    }
  },
  "toolbox": {
    "host": "https://kanban.mwolff.org",
    "tokenFile": ".claude/toolbox.cli/tbx.token",
    "ideaStored": false
  },
  "issueReview": {
    "rounds": 1,
    "requiredBeforeReady": false,
    "reviewers": [
      {
        "name": "opus",
        "kind": "claude",
        "model": "claude-opus-5"
      },
      {
        "name": "sonnet",
        "kind": "claude",
        "model": "claude-sonnet-5"
      },
      {
        "name": "fable",
        "kind": "claude",
        "model": "claude-fable-5.1"
      },
      {
        "name": "gpt-sol",
        "kind": "command",
        "model": "gpt-5.6-sol",
        "command": "codex exec --model gpt-5.6-sol -c model_reasoning_effort=\"high\""
      },
      {
        "name": "gpt-astra",
        "kind": "command",
        "model": "gpt-6-astra",
        "command": "codex exec --model gpt-6-astra -c model_reasoning_effort=\"high\""
      }
    ],
    "pairs": {
      "opus": [
        "fable",
        "gpt-astra"
      ],
      "sonnet": [
        "fable",
        "gpt-sol"
      ],
      "fable": [
        "opus",
        "gpt-astra"
      ]
    },
    "statusLabels": true
  }
}
